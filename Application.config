# CMS application configuration. Edit this file before packaging, or set
# -Dcms.config.path=/absolute/path/Application.config to load an external copy.

# Branding
application.name=CMS – Collections Management System
application.short-name=CMS
application.company-name=Bharat Small Finance Company
application.footer-name=Bharat Small Finance Company
application.menu.users=User Management
application.menu.roles=Roles & Permissions
application.menu.masters=Application Masters
application.menu.risk=Risk Rules & Allocation
application.menu.audit=Audit Logs
application.menu.owner=Performance Report
application.menu.collector-performance=Collector Performance
application.menu.allocation=Customer Allocation
application.menu.dashboard=Dashboard
application.menu.customers=Customer Worklist
application.menu.reports=Collector Reports
application.menu.profile=Change Password

# Database. The desktop client connects using direct JDBC; the JNDI key is retained for the web edition.
database.datasource.jndi=java:jboss/datasources/CmsDS
database.jdbc.driver=oracle.jdbc.OracleDriver
database.jdbc.url=jdbc:oracle:thin:@//localhost:1521/ORCLPDB
database.jdbc.username=CMS_AWT
database.jdbc.password=CMS_AWT

# Authentication defaults (development default; change before deployment).
security.default-user-password=PAss@1

# Application display defaults. CMS_APP_CONFIG can override branding and preferences.
ui.default.theme=SYSTEM
ui.default.accent=#2563eb
ui.default.font-size=11
ui.default.font-family=INTER
ui.font-size.minimum=10
ui.font-size.maximum=22
ui.theme.options=SYSTEM:Follow device (default),LIGHT:Classic Light,DARK:Midnight Dark,OCEAN:Ocean Breeze,EMERALD:Emerald Garden,VIOLET:Royal Violet,ROSE:Rose Quartz,AMBER:Amber Glow,NORDIC:Nordic Ice,SLATE:Slate Graphite
ui.theme.accents=SYSTEM:#2563eb,LIGHT:#2563eb,DARK:#818cf8,OCEAN:#0891b2,EMERALD:#059669,VIOLET:#7c3aed,ROSE:#e11d48,AMBER:#d97706,NORDIC:#0891b2,SLATE:#475569
ui.font-family.options=INTER:Inter,ROBOTO:Roboto,SEGOE_UI:Segoe UI,ARIAL:Arial,CALIBRI:Calibri,TAHOMA:Tahoma,VERDANA:Verdana,TREBUCHET_MS:Trebuchet MS,CANDARA:Candara,CORBEL:Corbel

# Paging and session policy
session.timeout.minutes=30
pagination.users=20
pagination.customers=25
pagination.audit=15
pagination.collector-reports=15
pagination.collector-performance=20
pagination.customer-followups=5
pagination.payment-history=5
pagination.communication-history=5
pagination.customer-followup-summary=100
dashboard.recent-followups=8
assets.version=20261108-12

# Log4j2 values consumed by log4j2.xml after application startup.
logging.directory=logs
logging.file-name=cms-application.log
logging.archive-pattern=cms-application-%d{yyyy-MM-dd}-%i.log.gz
logging.pattern=%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger [request=%X{requestId} userId=%X{userId} userName=%X{userName}] - %msg%throwable%n
logging.application-level=info
logging.root-level=info
logging.rotation-size=10 MB
logging.retained-archives=14
